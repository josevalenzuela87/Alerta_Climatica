# Archivos de configuración sensibles
.env
.env.local
.env.development
.env.production
config/firebase-config.js

# Node modules (si se usa npm)
node_modules/
package-lock.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos temporales
tmp/
temp/
*.tmp

# Build
dist/
build/

